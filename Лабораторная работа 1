import platform
import psutil
import os
import json

a = {
    "Информация о" : "ОС:",  #просто пометки, написаны как элементы словаря
    "OC" : platform.system(),
    "Версия" : platform.release(),
    "Архитектура" : platform.machine(),
    "Имя ПК в сети" : platform.node(),
    "Информация о" : "процессоре:",
    "Процессор" : platform.processor(),
    "Ядер": psutil.cpu_count(logical=False),
    "Логических процессоров" : psutil.cpu_count(),
    "Частота процессора" : (
        f"Сейчас: {psutil.cpu_freq().current}",
        f"min: {psutil.cpu_freq().min}", 
        f"max: {psutil.cpu_freq().max}"
        ), #в значение добавил кортеж
    "Загрузка процессора" : (f"{psutil.cpu_percent()} %"),
    "Оперативная" : "память:" ,
    "Всего RAM" : round(              #round( , 2) - округляем до 2-х знаков после запятой
        psutil.virtual_memory().total / 1024**3, 2
      ),                                                                   #также и тут можно было юзать кортеж в значении
    "Доступно RAM" : round(
        psutil.virtual_memory().available / 1024**3, 2
        ),  #но сдесь отдельно
    "Загрузка RAM" : (f"{psutil.virtual_memory().percent} %"),   #расписал каждую функцию
    "Используется" : round(psutil.virtual_memory().used / 1024**3, 2),  #можно делать и так и так
    #"Информация о" : "жестком диске:",
    #"Диск" : (
            #f"total: {psutil.disk_usage("/").total // 1024**3} ГБ, " 
            #f"используется: {psutil.disk_usage("/").used // 1024**3} ГБ, " 
            #f"в процентах: {psutil.disk_usage("/").percent}%, "  
            #f"свободно: {psutil.disk_usage("/").free // 1024**3} ГБ",
            #), #в значение добавил кортеж
    #"Информация о" : "сети",
    #"Сетевой интерфейс" : psutil.net_if_addrs(),
    #"Статистика передачи данных" : psutil.net_io_counters(),
    "Батарея" : "(только для ноутбуков):",
    "Заряд" : f"{psutil.sensors_battery().percent} %",
    "Подключено ли питание" : f"{psutil.sensors_battery().power_plugged}",
    "До разряжения осталось ~" : f"{round(psutil.sensors_battery().secsleft / 60, 2)} минут",
}


for process in psutil.process_iter(): #psutil.process_iter() - выдает нам обьекты процессов
    a[process.pid] = process.name() #process.pid - смотрим атрибуты (т.е. уже хранящееся знач)
           #process.name() - name это метод, т.е. функция которую нужно вызвать, поэтому она с () в конце, а pid нет

if platform.system() == "Windows":
     
     a["Информация"] = "о жестком диске:"
     a["total:"] = f"{psutil.disk_usage("C:\\").total // 1024**3} ГБ"
     a["используется:"] = f"{psutil.disk_usage("C:\\").used // 1024**3} ГБ"
     a["в процентах:"] = f"{psutil.disk_usage("C:\\").percent}%"
     a["свободно:"] = f"{psutil.disk_usage("C:\\").free // 1024**3} ГБ"
     a["Окружение:"] = (os.environ["USERPROFILE"])
        
elif platform.system() == "Linux":
     disk = psutil.disk_usage("/")   #еще можно сделать так -> присвоить результат выполнения функции переменной
     a["1. Информация"] = "о жестком диске:",
     a["total"] = f"{disk.total // 1024**3} ГБ"  #и тут уже смотреть атрибуты от этой переменной 
     a["используется:"] = f"{disk.used // 1024**3} ГБ" 
     a["в процентах:"] = f"{disk.percent}%" 
     a["свободно:"] = f"{disk.free // 1024**3} ГБ"
     a["Окружение:"] = os.environ["HOME"]
     a["Информация о системе:"] = os.listdir("/proc")
 #в значение добавил кортеж

for i, k in a.items():
    print(i, k)   #Перебираем словарь сверху

with open("system_info.json", "w", encoding="utf-8") as file:
    json.dump(a, file, ensure_ascii=False, indent=4)